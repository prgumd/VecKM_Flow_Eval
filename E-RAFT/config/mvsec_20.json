{
    "name": "mvsec_20Hz",
    "cuda": true,
    "gpu": 0,
    "subtype": "warm_start",
    "save_dir": "./outputs/e-raft",
    "data_loader": {
        "test": {
            "args": {
                "batch_size": 1,
                "shuffle": false,
                "sequence_length": 1,
                "num_voxel_bins": 15,
                "align_to": "depth",
                "datasets": {
                    "03": [
                        40
                    ]
                },
                "filter": {
                    "03": {
                        "40": "range(0, 2058)"
                    }
                },
                "transforms": [
                    "EventSequenceToVoxelGrid_Pytorch(num_bins=15, normalize=True, gpu=True)",
                    "RandomCropping(crop_height=480, crop_width=640, fixed=True)"
                ]
            }
        }
    },
    "test": {
        "checkpoint": "checkpoints/dsec.tar"
    }
}
